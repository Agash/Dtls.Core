<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Needed for IDE0005 (unused usings) to run in the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML file only feeds the analyzers; a native executable ships without it, and the SDK's
         AOT publish looks for it where it never copies it (MSB3030 with SDK 11 rc.2). -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dtls.Core\Dtls.Core.csproj" />
  </ItemGroup>
</Project>
