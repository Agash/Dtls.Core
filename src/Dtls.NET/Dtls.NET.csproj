<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Dtls.NET</RootNamespace>
    <!-- The shipped library runs the recommended rule set as errors; tests stay on the default set. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- IsAotCompatible only runs the analyzers on this project; this also checks that everything
         it references is annotated compatible. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Dtls.NET</PackageId>
    <Description>DTLS 1.2 and 1.3 for .NET on the platform's own cryptography: a sans-IO protocol engine with version negotiation and DTLS-SRTP (use_srtp and the keying material exporter) for WebRTC, self-signed certificates and fingerprint authentication, cookie exchange, fragmentation, retransmission and replay protection. No native dependencies. Native AOT compatible.</Description>
    <PackageTags>dtls;dtls13;dtls-srtp;srtp;webrtc;tls;udp;security;cryptography;sans-io;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="Dtls.NET.Tests" />
  </ItemGroup>
</Project>
